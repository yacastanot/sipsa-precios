# ─── Parámetros semanales SIPSA ───────────────────────────────────────────────
# Copiar como .env y completar con los valores de la semana
# Ver docs/03_configuracion.md para la descripción de cada variable

SIPSA_FECHA=27FEB2026
SIPSA_ARCHIVO=Listado a 27 feb 26.xlsx

# ─── API web (opcional) ────────────────────────────────────────────────────────
# Solo necesario si se usa uvicorn app:app
# Cambiar antes de exponer el servidor en red

SIPSA_USER=
SIPSA_PASS=
